{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^nextcloud-apps\\.txt$/"],
      "matchStrings": ["(?<depName>[a-z_]+)@(?<currentValue>\\S+)"],
      "datasourceTemplate": "nextcloud",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["nextcloud"],
      "registryUrls": [
        "https://apps.nextcloud.com/api/v1/platform/30.0.0/apps.json"
      ],
      "groupName": "nextcloud apps"
    },
    {
      "matchDatasources": ["nextcloud"],
      "matchPackageNames": ["calendar"],
      "allowedVersions": "<=5.5.9"
    }
  ]
}
